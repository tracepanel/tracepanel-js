{
  "name": "@tracepanel/js",
  "version": "0.5.0",
  "description": "Traces and logs for Node.js and Bun apps (Express, Fastify, Koa, Hono, NestJS, Next.js, Nuxt, Bun.serve): every request with its SQL, logs and errors, N+1 queries found",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.0",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "default": "./dist/koa.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next/widget": {
      "types": "./dist/next-widget.d.ts",
      "default": "./dist/next-widget.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "bin": {
    "tracepanel": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit",
    "fmt": "biome check --write ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.78.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-mongodb": "^0.76.0",
    "@opentelemetry/instrumentation-mysql2": "^0.69.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-redis": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@prisma/instrumentation": "^7.10.0",
    "@tracepanel/agent": "~0.5.0",
    "import-in-the-middle": "^3.5.2"
  },
  "peerDependencies": {
    "@types/express": ">=4.17",
    "@types/koa": ">=3",
    "express": ">=4.18",
    "fastify": ">=5",
    "hono": ">=4.8",
    "koa": ">=3",
    "react": ">=18",
    "vitest": ">=4.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/openai": "^4.0.102",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@biomejs/biome": "2.5.15",
    "@fastify/formbody": "^9.0.1",
    "@hono/node-server": "^2.1.5",
    "@koa/router": "^15.7.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "ai": "^7.0.153",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^6.3.17",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fastify": "^5.12.7",
    "h3": "^1.15.11",
    "happy-dom": "^21.0.1",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "koa": "^3.2.1",
    "libsql": "^0.5.29",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "winston": "^3.19.0"
  },
  "keywords": [
    "anthropic",
    "aws",
    "bun",
    "express",
    "fastify",
    "hono",
    "koa",
    "llm",
    "n+1",
    "nestjs",
    "nextjs",
    "nuxt",
    "openai",
    "opentelemetry",
    "pino",
    "sql",
    "sqlite",
    "tracing",
    "vitest",
    "winston"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracepanel/tracepanel-js.git"
  },
  "homepage": "https://tracepanel.dev/docs/javascript"
}
